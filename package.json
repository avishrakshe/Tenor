{
  "name": "tenor-near",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sandbox": "node scripts/sandbox.mjs",
    "deploy": "node scripts/deploy.mjs",
    "wasm:optimize": "node scripts/optimize-wasm.mjs",
    "faucet": "node scripts/faucet.mjs",
    "demo:eval": "node scripts/demo-eval.mjs",
    "demo:breach": "node scripts/demo-breach.mjs",
    "demo:oneclick": "node scripts/demo-oneclick.mjs",
    "attack-demo": "node agent/attack-demo.mjs",
    "agent": "node agent/agent.mjs",
    "keeper": "node keeper/keeper.mjs",
    "test": "node --test \"packages/rules-ts/test/*.test.mjs\"",
    "dev": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web"
  },
  "dependencies": {
    "bs58": "^6.0.0",
    "dotenv": "^17.2.0",
    "near-api-js": "^7.0.0"
  },
  "devDependencies": {
    "binaryen": "^132.0.0"
  }
}
