# Copy to .env. Never commit .env.

# Testnet root account that owns the deployment. Create one with:
#   near account create-account sponsor-by-faucet-service <name>.testnet ...
TENOR_ROOT_ACCOUNT=
TENOR_ROOT_KEY=ed25519:...

# Network used by the scripts when --network is not passed: sandbox or testnet.
TENOR_NETWORK=testnet

# Optional. 1Click works without a key but adds a 0.25% fee.
ONECLICK_JWT=

# Optional. Only for `npm run attack-demo -- --llm`.
ANTHROPIC_API_KEY=
