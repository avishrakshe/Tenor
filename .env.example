# Copy to .env. Never commit .env.

# Testnet root account that owns the deployment. Create one with:
#   near account create-account sponsor-by-faucet-service <name>.testnet ...
TENOR_ROOT_ACCOUNT=
TENOR_ROOT_KEY=ed25519:...

# Network used by the scripts when --network is not passed: sandbox or testnet.
TENOR_NETWORK=testnet

# Google login, through Clerk. Set by `vercel integration add clerk`, then `vercel env pull`.
# Optional: without them the site runs with no Google login, and wallets still sign every transaction.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Web app price keeper, written to apps/web/.env.local by `npm run keeper:keys`. Each key can only
# call push_prices on one oracle. Not needed on a local sandbox.
KEEPER_ACCOUNT=
KEEPER_KEY_LIVE=
KEEPER_KEY_DEMO=

# Optional. 1Click works without a key but adds a 0.25% fee.
ONECLICK_JWT=

# Optional. Only for `npm run attack-demo -- --llm`.
ANTHROPIC_API_KEY=
